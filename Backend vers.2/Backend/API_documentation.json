{
  "info": {
    "name": "Sipodoro Backend API",
    "description": "API documentation for the Sipodoro backend (Group 1 Final Project). Base path for all resource routes is /api. Most routes require a Bearer JWT obtained from /api/auth/login.\n\nHow to use:\n1. Set the `baseUrl` variable (defaults to http://localhost:5000).\n2. Run 'Auth > Register' once, then 'Auth > Login'. Login automatically saves the returned token to the `token` collection variable.\n3. All other requests use {{token}} automatically via collection-level Bearer auth.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "taskId", "value": "1", "type": "string" },
    { "key": "cycleId", "value": "1", "type": "string" },
    { "key": "flowerId", "value": "1", "type": "string" },
    { "key": "seedId", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "Health Check",
      "item": [
        {
          "name": "API Root / Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/", "host": ["{{baseUrl}}"], "path": [""] },
            "description": "Confirms the server is running. Returns { message: 'Sipodoro backend running!' }"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "description": "Public registration/login plus protected profile/logout. Base path: /api/auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser1\",\n  \"email\": \"testuser1@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] },
            "description": "Creates a new user (username, email, password required). Assigns role 'admin' only if email is admin@sipodoro.com, otherwise 'user'. Also auto-creates wallet, garden, and streak records for the user."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const data = pm.response.json();",
                  "    if (data.token) {",
                  "        pm.collectionVariables.set('token', data.token);",
                  "        console.log('Token saved to collection variable.');",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testuser1@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "description": "Accepts email OR username in the 'email' field plus password. Returns a JWT (expires in 1 day). Test script auto-saves the token."
          }
        },
        {
          "name": "Get Profile (from token)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/auth/profile", "host": ["{{baseUrl}}"], "path": ["api", "auth", "profile"] },
            "description": "Requires Bearer token. Returns the decoded user info attached by the auth middleware."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "auth", "logout"] },
            "description": "Requires Bearer token. Client-side token invalidation only (no server-side blacklist)."
          }
        }
      ]
    },
    {
      "name": "Users",
      "description": "Base path: /api/users. All routes require Bearer token.",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/users/profile", "host": ["{{baseUrl}}"], "path": ["api", "users", "profile"] }
          }
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"newUsername\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/users/profile", "host": ["{{baseUrl}}"], "path": ["api", "users", "profile"] },
            "description": "Body is passed straight through to the service layer; send any updatable User fields (e.g. username)."
          }
        }
      ]
    },
    {
      "name": "Tasks",
      "description": "Base path: /api/tasks. Full CRUD, all routes require Bearer token.",
      "item": [
        {
          "name": "Get All Tasks",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/tasks", "host": ["{{baseUrl}}"], "path": ["api", "tasks"] }
