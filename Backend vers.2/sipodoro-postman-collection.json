    {
      "name": "Coins",
      "item": [
        {
          "name": "GET /api/coins/wallet",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/coins/wallet",
              "host": ["{{base_url}}"],
              "path": ["api", "coins", "wallet"]
            },
            "description": "Get the authenticated user's coin wallet (balance, etc.)."
          },
          "response": [
            {
              "name": "Success",
              "status": "OK",
              "code": 200,
              "header": [
