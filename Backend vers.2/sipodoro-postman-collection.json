              "status": "OK",
              "code": 200,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"task_id\": 1,\n  \"user_id\": 1,\n  \"title\": \"Finish project report\",\n  \"deadline\": \"2025-06-15T00:00:00.000Z\",\n  \"status\": \"Urgent\",\n  \"completed\": false,\n  \"created_at\": \"2025-01-01T00:00:00.000Z\",\n  \"updated_at\": \"2025-01-01T00:00:00.000Z\"\n}"
