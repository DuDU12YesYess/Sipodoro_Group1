    {
      "name": "Pomodoro",
      "item": [
        {
          "name": "POST /api/pomodoro/start",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"focus_duration\": 25,\n  \"break_duration\": 5\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/pomodoro/start",
              "host": ["{{base_url}}"],
              "path": ["api", "pomodoro", "start"]
            },
            "description": "Start a new Pomodoro cycle.\n\n**Fields:**\n- `focus_duration` — Focus time in minutes (default: `25`)\n- `break_duration` — Break time in minutes (default: `5`)\n\n**Note:** Rejects if the user already has an active (uncompleted) cycle."
          },
          "response": [
            {
              "name": "Created",
              "status": "Created",
              "code": 201,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"cycle_id\": 1,\n  \"user_id\": 1,\n  \"focus_duration\": 25,\n  \"break_duration\": 5,\n  \"completed_focus_sessions\": 0,\n  \"completed_break\": 0,\n  \"started_at\": \"2025-01-01T10:00:00.000Z\",\n  \"completed_at\": null\n}"
            }
          ]
        },
        {
          "name": "POST /api/pomodoro/save",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"duration\": 25,\n  \"mode\": \"focus\",\n  \"date\": \"2025-01-01\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/pomodoro/save",
              "host": ["{{base_url}}"],
              "path": ["api", "pomodoro", "save"]
            },
            "description": "Save a completed Pomodoro session directly (creates a pre-completed cycle).\n\n**Fields:**\n- `duration` (required) — Session duration in minutes\n- `mode` (required) — `\"focus\"` or `\"break\"` (if `\"focus\"`, streak is updated)\n- `date` — Session date (defaults to current date)"
          },
          "response": [
            {
              "name": "Created",
              "status": "Created",
              "code": 201,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"cycle_id\": 2,\n  \"user_id\": 1,\n  \"duration\": 25,\n  \"mode\": \"focus\",\n  \"completed_at\": \"2025-01-01T10:25:00.000Z\"\n}"
            }
          ]
        },
        {
          "name": "POST /api/pomodoro/focus-complete/:cycleId",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/pomodoro/focus-complete/1",
              "host": ["{{base_url}}"],
              "path": ["api", "pomodoro", "focus-complete", "1"],
              "variable": [
                { "key": "cycleId", "value": "1", "description": "PomodoroCycle ID" }
              ]
            },
            "description": "Mark a focus session as complete for a given cycle. Increments `completed_focus_sessions`. If it reaches 4, automatically completes the entire cycle and updates the user's streak."
          },
          "response": [
            {
              "name": "Success",
              "status": "OK",
              "code": 200,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"cycle_id\": 1,\n  \"user_id\": 1,\n  \"focus_duration\": 25,\n  \"break_duration\": 5,\n  \"completed_focus_sessions\": 1,\n  \"completed_break\": 0,\n  \"started_at\": \"2025-01-01T10:00:00.000Z\",\n  \"completed_at\": null\n}"
            }
          ]
        },
        {
          "name": "POST /api/pomodoro/break-complete/:cycleId",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/pomodoro/break-complete/1",
              "host": ["{{base_url}}"],
              "path": ["api", "pomodoro", "break-complete", "1"],
              "variable": [
                { "key": "cycleId", "value": "1", "description": "PomodoroCycle ID" }
              ]
            },
            "description": "Mark a break session as complete for a given cycle. Increments `completed_break`."
          },
          "response": [
            {
              "name": "Success",
              "status": "OK",
              "code": 200,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"cycle_id\": 1,\n  \"user_id\": 1,\n  \"focus_duration\": 25,\n  \"break_duration\": 5,\n  \"completed_focus_sessions\": 1,\n  \"completed_break\": 1,\n  \"started_at\": \"2025-01-01T10:00:00.000Z\",\n  \"completed_at\": null\n}"
            }
          ]
        },
        {
          "name": "GET /api/pomodoro/history",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/pomodoro/history",
              "host": ["{{base_url}}"],
              "path": ["api", "pomodoro", "history"]
            },
            "description": "Get all Pomodoro cycle history for the authenticated user."
          },
          "response": [
            {
              "name": "Success",
              "status": "OK",
              "code": 200,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "[\n  {\n    \"cycle_id\": 1,\n    \"user_id\": 1,\n    \"focus_duration\": 25,\n    \"break_duration\": 5,\n    \"completed_focus_sessions\": 4,\n    \"completed_break\": 4,\n    \"started_at\": \"2025-01-01T10:00:00.000Z\",\n    \"completed_at\": \"2025-01-01T12:00:00.000Z\"\n  }\n]"
            }
          ]
        }
      ],
      "description": "Pomodoro timer cycle management endpoints."
    },
