              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/users/profile",
              "host": ["{{base_url}}"],
              "path": ["api", "users", "profile"]
            },
            "description": "Update the authenticated user's profile (username and/or email). Both fields must be unique among other users."
          },
          "response": [
            {
              "name": "Success",
              "status": "OK",
              "code": 200,
              "header": [
                { "key": "Content-Type", "value": "application/json" }
              ],
              "body": "{\n  \"user_id\": 1,\n  \"username\": \"newusername\",\n  \"email\": \"newemail@example.com\",\n  \"role\": \"user\"\n}"
            }
          ]
